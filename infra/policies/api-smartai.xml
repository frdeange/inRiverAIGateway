<policies>
  <inbound>
    <base />
    <set-variable name="requestBody" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition="@(context.Product.Name == &quot;Developer&quot;)">
        <set-backend-service backend-id="localollama-openai-endpoint" />
        <set-variable name="modelTier" value="developer" />
        <rewrite-uri template="/v1/chat/completions" />
        <set-body>@{
           var body = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["requestBody"]);
           body["model"] = "phi4-mini";
           return body.ToString();
         }</set-body>
      </when>
      <when condition="@(context.Product.Name == &quot;Economy&quot;)">
        <set-backend-service backend-id="OpenAI-Balanced" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
        <set-variable name="modelTier" value="economy" />
        <rewrite-uri template="/openai/deployments/gpt-4.1/chat/completions?api-version=2024-10-21" />
        <set-body>@{
           var body = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["requestBody"]);
           body["model"] = "gpt-4.1";
           return body.ToString();
         }</set-body>
      </when>
      <otherwise>
        <set-backend-service backend-id="OpenAI-Balanced" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
        <set-variable name="modelTier" value="premium" />
        <rewrite-uri template="/openai/deployments/gpt-5.2/chat/completions?api-version=2024-10-21" />
        <set-body>@{
           var body = Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["requestBody"]);
           body["model"] = "gpt-5.2";
           return body.ToString();
         }</set-body>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="x-model-tier" exists-action="override">
      <value>@((string)context.Variables["modelTier"])</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
