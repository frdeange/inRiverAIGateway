###############################################################################
# Sensitive values. Copy to secrets.auto.tfvars (NEVER commit it).
# Terraform auto-loads any file matching *.auto.tfvars.
###############################################################################

# Used by the @secure() parameter in the original Bicep export. May be the same
# value as the "jwt-signing-key" named value depending on which policies
# consume it.
jwt_signing_key = "REPLACE_ME_JWT_SIGNING_KEY"

# Map of secret APIM named values. Keys MUST match entries in `apim_named_values`
# that have `secret = true`.
apim_named_value_secrets = {
  # Logger-Credentials (long opaque string used by the App Insights logger policy).
  "6a01ab85f719a81f409c75f3" = "REPLACE_ME_LOGGER_CREDENTIALS"

  # JWT signing key used by the validate-jwt policies.
  "jwt-signing-key" = "REPLACE_ME_JWT_SIGNING_KEY"
}
