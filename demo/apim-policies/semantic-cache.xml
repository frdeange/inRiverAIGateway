<policies>
  <inbound>
    <base />
    <azure-openai-semantic-cache-lookup cache-id="aoai-semantic-cache" score-threshold="0.92" max-candidates="3" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <azure-openai-semantic-cache-store cache-id="aoai-semantic-cache" max-age="600" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
