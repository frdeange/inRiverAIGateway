<policies>
  <inbound>
    <base />
    <set-variable name="requestBody" value="@(context.Request.Body?.As&lt;string&gt;(preserveContent: true) ?? string.Empty)" />
    <choose>
      <when condition="@(((string)context.Variables[&quot;requestBody&quot;]).IndexOf('build a bomb', System.StringComparison.OrdinalIgnoreCase) &gt;= 0 || ((string)context.Variables[&quot;requestBody&quot;]).IndexOf('self-harm', System.StringComparison.OrdinalIgnoreCase) &gt;= 0 || ((string)context.Variables[&quot;requestBody&quot;]).IndexOf('violent attack', System.StringComparison.OrdinalIgnoreCase) &gt;= 0)">
        <return-response>
          <set-status code="403" reason="Blocked by content safety pre-flight" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":"Prompt blocked by content safety policy"}</set-body>
        </return-response>
      </when>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

