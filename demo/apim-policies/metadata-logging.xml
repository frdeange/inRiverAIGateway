<policies>
  <inbound>
    <base />
    <set-variable name="tenant_id" value="@(context.Request.Headers.GetValueOrDefault('x-tenant-id', 'unknown'))" />
    <set-variable name="agent_name" value="@(context.Request.Headers.GetValueOrDefault('x-agent-name', 'unknown'))" />
    <set-variable name="model_name" value="@(context.Request.Headers.GetValueOrDefault('x-model', 'gpt-4o'))" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-variable name="responseBody" value="@(context.Response?.Body?.As&lt;string&gt;(preserveContent: true) ?? string.Empty)" />
    <set-variable name="total_tokens" value="@{
        var body = (string)context.Variables[&quot;responseBody&quot;];
        if (string.IsNullOrEmpty(body)) { return &quot;0&quot;; }
        try {
            var obj = Newtonsoft.Json.Linq.JObject.Parse(body);
            return (string)(obj.SelectToken(&quot;usage.total_tokens&quot;) ?? &quot;0&quot;);
        }
        catch {
            return &quot;0&quot;;
        }
    }" />
    <trace source="ai-gateway-demo" severity="information">
      <message>@("tenant_id=" + (string)context.Variables["tenant_id"] + ";agent_name=" + (string)context.Variables["agent_name"] + ";model=" + (string)context.Variables["model_name"] + ";tokens=" + (string)context.Variables["total_tokens"])</message>
      <metadata name="tenant_id" value="@((string)context.Variables[&quot;tenant_id&quot;])" />
      <metadata name="agent_name" value="@((string)context.Variables[&quot;agent_name&quot;])" />
      <metadata name="model" value="@((string)context.Variables[&quot;model_name&quot;])" />
      <metadata name="tokens" value="@((string)context.Variables[&quot;total_tokens&quot;])" />
    </trace>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

