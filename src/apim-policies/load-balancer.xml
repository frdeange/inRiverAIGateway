<policies>
  <inbound>
    <base />
    <set-variable name="routeRoll" value="@(System.Math.Abs(context.RequestId.GetHashCode()) % 100)" />
    <choose>
      <when condition="@((int)context.Variables[&quot;routeRoll&quot;] &lt; 50)">
        <set-variable name="backendRegion" value="swedencentral" />
        <set-backend-service base-url="https://inriver-aigw-foundry-sec.openai.azure.com/openai/deployments/gpt-5.2/chat/completions?api-version=2024-10-21" />
      </when>
      <when condition="@((int)context.Variables[&quot;routeRoll&quot;] &lt; 80)">
        <set-variable name="backendRegion" value="francecentral" />
        <set-backend-service base-url="https://inriver-aigw-foundry-frc.openai.azure.com/openai/deployments/gpt-5.2/chat/completions?api-version=2024-10-21" />
      </when>
      <otherwise>
        <set-variable name="backendRegion" value="spaincentral" />
        <set-backend-service base-url="https://inriver-aigw-foundry-esp.openai.azure.com/openai/deployments/gpt-5.2/chat/completions?api-version=2024-10-21" />
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
    <forward-request buffer-request-body="true" />
  </backend>
  <outbound>
    <base />
    <set-header name="x-backend-region" exists-action="override">
      <value>@((string)context.Variables.GetValueOrDefault(&quot;backendRegion&quot;, &quot;unknown&quot;))</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
