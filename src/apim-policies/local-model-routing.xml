<policies>
  <inbound>
    <base />
    <choose>
      <!-- Route to local model when x-model-target is "local" or the subscription name is "Local Model". -->
      <when condition="@(context.Request.Headers.GetValueOrDefault('x-model-target','') == 'local' || string.Equals(context.Subscription?.Name, 'Local Model', System.StringComparison.OrdinalIgnoreCase))">
        <!-- DevTunnel URL exposing local Ollama. Recreate with: devtunnel host ollama-aigw -->
        <set-backend-service base-url="https://299hwf0x-11434.uks1.devtunnels.ms/v1/chat/completions" />
        <set-variable name="backendRegion" value="on-premises" />
      </when>
      <otherwise>
        <!-- Default: Azure Foundry -->
        <set-backend-service base-url="https://inriver-aigw-foundry-sec.openai.azure.com/openai/deployments/gpt-5.2/chat/completions?api-version=2024-10-21" />
        <set-variable name="backendRegion" value="swedencentral" />
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
    <forward-request buffer-request-body="true" />
  </backend>
  <outbound>
    <base />
    <set-header name="x-backend-region" exists-action="override">
      <value>@((string)context.Variables.GetValueOrDefault("backendRegion", "unknown"))</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
