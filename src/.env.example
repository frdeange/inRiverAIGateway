# Azure OpenAI / Foundry endpoints
FOUNDRY_SEC_ENDPOINT=https://<sweden-foundry>.openai.azure.com/
FOUNDRY_FRC_ENDPOINT=https://<france-foundry>.openai.azure.com/
FOUNDRY_ESP_ENDPOINT=https://<spain-foundry>.openai.azure.com/

# Model deployment defaults
MODEL_DEPLOYMENT=gpt-5.2
API_VERSION=2024-10-21

# APIM
APIM_NAME=<apim-service-name>
AI_GATEWAY_URL=https://<apim-name>.azure-api.net/ai
AI_GATEWAY_KEY=<apim-subscription-key>

# Demo 1 bonus local model
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=phi4-mini

# Demo 2 smart routing
REQUESTS_PER_TIER=10
SMARTAI_PREMIUM_KEY=<premium-subscription-key>
SMARTAI_PREMIUM_DESC=Best quality, multi-region balanced
SMARTAI_ECONOMY_KEY=<economy-subscription-key>
SMARTAI_ECONOMY_DESC=Cost-effective, multi-region balanced
SMARTAI_DEVELOPER_KEY=<developer-subscription-key>
SMARTAI_DEVELOPER_DESC=On-premises, zero cloud dependency

# Demo 3 noisy-neighbor
NOISY_CUSTOMER_A_KEY=<customer-a-key>
NOISY_CUSTOMER_A_NAME=Customer A (normal usage)
NOISY_CUSTOMER_B_KEY=<customer-b-key>
NOISY_CUSTOMER_B_NAME=Customer B (batch workload)

# Demo 4 enterprise JWT + credits
JWT_SECRET=<shared-hs256-secret>
CREDIT_SERVICE_URL=https://<credit-service>.azurecontainerapps.io

# Monitoring / misc
MCP_SERVER_URL=https://<mcp-server>.azurecontainerapps.io/mcp
APPINSIGHTS_NAME=<app-insights-name>
RESOURCE_GROUP=<resource-group>